# Optional settings. The setup works without a .env file.
# To change something: cp .env.example .env, then edit .env (it is ignored by Git).
# Running ../2-dial-advanced-setup? Put your settings in its .env instead.

# --- Models ------------------------------------------------------------------
# Ollama models to download. If you change one, also change the "overrideName"
# of its deployment to the same name, in DIAL Admin or in
# ../core/config.json: see README.md, "Change a model".
# Deployment ollama-qwen2.5
OLLAMA_CHAT_MODEL=qwen2.5:0.5b

# Deployment ollama-llama3.2
OLLAMA_SECOND_CHAT_MODEL=llama3.2:1b

# Deployment ollama-all-minilm
OLLAMA_EMBEDDING_MODEL=all-minilm

# Vision model for AI Agent Sample. It must
# match the "overrideName" of ollama-llava-vision in
# ../core/config.json. An empty value skips the
# LLaVA download (about 4.7 GB); picture analysis then does not work.
OLLAMA_VISION_MODEL=llava
# Core deployment IDs used by the AI Agent Sample. AGENT_MODEL must support tools.
AGENT_MODEL=ollama-qwen2.5
VISION_MODEL=ollama-llava-vision
# Time allowed for each model call; CPU models load slowly the first time.
MODEL_TIMEOUT_SECONDS=300

# Deployment ID from ../core/config.json that Chat selects by default.
DEFAULT_DEPLOYMENT=ollama-qwen2.5

# One model and one request at a time: models running side by side fight over
# the same CPU cores. A model stays loaded for OLLAMA_KEEP_ALIVE after its last use.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_LENGTH=4096

# --- Platform ----------------------------------------------------------------
# Leave empty on Windows, Linux and Intel Macs. On an Apple Silicon Mac, set
# linux/amd64: Chat and Admin have no ARM build, so Docker runs them
# through emulation. All other images run natively.
DIAL_PLATFORM=

# --- Ports on localhost ------------------------------------------------------
DIAL_CHAT_PORT=8055
DIAL_ADMIN_FRONTEND_PORT=8056
KC_PORT=8058
DIAL_CORE_PORT=8059
DIAL_THEMES_PORT=8063
OLLAMA_PORT=8064
AGENT_APP_PORT=8065

# --- Local development passwords and secrets ---------------------------------
# Generate your own values with: openssl rand -hex 32
# Password of the "dial", "user" and "dial-admin" accounts. Applied when Keycloak first starts.
DIAL_USER_PASSWORD=dial
KC_ADMIN_PASSWORD=admin-password
AUTH_KEYCLOAK_SECRET=keycloak_secret
NEXTAUTH_SECRET=local-development-nextauth-secret-change-me

# Exactly 64 hex characters.
AUTH_SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Keep these stable while you keep Core's data.
DIAL_CORE_ENCRYPTION_SECRET=local-development-salt
DIAL_CORE_ENCRYPTION_KEY=local-development-encryption-key
DIAL_CORE_LOGGING_SALT=local-development-logging-salt
# Core API keys (such as dial_api_key) are defined in ../core/config.json.

# --- Cloud models ------------------------------------------------------------
# Credentials for AWS Bedrock and Google Vertex AI models: see README.md,
# "Use cloud models".
# For Vertex AI, also save your credentials file as credentials/google.json in
# this folder, 1-dial-simple-setup, for both setups.
# For OpenAI, put your key into the gpt-6.1-terra model in DIAL Admin instead.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ASSUME_ROLE_ARN=
GCP_PROJECT_ID=
VERTEXAI_REGION=us-central1

# --- Image versions ----------------------------------------------------------
# docker-compose.yml pins versions that are tested together. To try another
# version, uncomment its line and change it.
# DIAL_CHAT_VERSION=1.2.14
# DIAL_ADMIN_FRONTEND_VERSION=0.22.1
# DIAL_CORE_VERSION=0.49.4
# DIAL_THEMES_VERSION=0.21.0
# Model Provider is a release candidate; it has no "latest" image.
# DIAL_MODEL_PROVIDER_VERSION=0.1.0-rc.0
