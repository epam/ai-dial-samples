# Optional settings. The setup works without a .env file.
# To change something: cp .env.example .env, then edit .env (it is ignored by Git).
#
# This .env also applies to the simple-setup services that this folder includes,
# so any setting from ../1-dial-simple-setup/.env.example can go here too
# (for example OLLAMA_CHAT_MODEL or DIAL_CHAT_PORT).

# --- Platform ----------------------------------------------------------------
# Leave empty on Windows, Linux and Intel Macs. On an Apple Silicon Mac, set
# linux/amd64: Chat, Quick Apps, Admin, Evaluation and Analytics have no ARM
# build, so Docker runs them through emulation.
DIAL_PLATFORM=

# --- Models ------------------------------------------------------------------
# Ollama model to download in addition to the simple setup's models. It must
# match the "overrideName" of ollama-llava-vision in
# ../core/2-dial-advanced-setup/config.json. An empty value skips the
# LLaVA download (about 4.7 GB); picture analysis then does not work.
OLLAMA_VISION_MODEL=llava
# Core deployment IDs used by the AI Agent Sample. AGENT_MODEL must support tools.
AGENT_MODEL=ollama-qwen2.5
VISION_MODEL=ollama-llava-vision
# Time allowed for each model call; CPU models load slowly the first time.
MODEL_TIMEOUT_SECONDS=300
# Core deployment IDs used by Evaluation: an LLM judge and an embedding model.
EVALUATION_JUDGE_MODEL=ollama-qwen2.5
EVALUATION_EMBEDDING_MODEL=ollama-all-minilm

# --- Ports on localhost ------------------------------------------------------
DIAL_ADMIN_FRONTEND_PORT=8056
EVALUATION_BACKEND_PORT=8060
EVALUATION_METRICS_PORT=8061
INFLUXDB_PORT=8062
AGENT_APP_PORT=8065

# --- Local development passwords and secrets ---------------------------------
# Generate your own values with: openssl rand -hex 32
NEXTAUTH_SECRET=local-development-nextauth-secret-change-me
EVALUATION_POSTGRES_PASSWORD=local-evaluation-password
# Must match the key in ../core/2-dial-advanced-setup/config.json.
DIAL_EVALUATION_API_KEY=dial_evaluation_api_key
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=influxdb-password
INFLUXDB_ORG=dial
INFLUXDB_BUCKET=analytics-realtime
INFLUXDB_ADMIN_TOKEN=local-development-influx-token

# --- Admin Analytics (a separately deployed service) -------------------------
# Base URL of the Analytics data-access service, reachable from the
# admin-frontend container. Setting it shows Admin's Analytics section.
# Not the analytics:5000 ingestion service or InfluxDB.
DIAL_ANALYTICS_API_URL=
# Optional enrichment runner; enables pipeline runtime controls.
DIAL_ANALYTICS_RUNNER_API_URL=
# Optional Core deployment for the Query Builder's AI view.
DIAL_QUERY_ASSISTANT_DEPLOYMENT=

# --- Cloud models ------------------------------------------------------------
# The Bedrock and Vertex AI adapters always run. Their models stay hidden until
# you give them userRoles, such as ["admin", "default"], in
# ../core/2-dial-advanced-setup/config.json.
# For Vertex AI, save your credentials file as ./credentials/google.json.
# For OpenAI, put your key into the gpt-4o upstream in that file instead.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ASSUME_ROLE_ARN=
GCP_PROJECT_ID=
VERTEXAI_REGION=us-central1

# --- Image versions ----------------------------------------------------------
DIAL_ADMIN_FRONTEND_VERSION=latest
DIAL_EVALUATION_BACKEND_VERSION=latest
DIAL_EVALUATION_METRICS_VERSION=latest
DIAL_ANALYTICS_VERSION=latest
DIAL_BEDROCK_ADAPTER_VERSION=latest
DIAL_VERTEXAI_ADAPTER_VERSION=latest
