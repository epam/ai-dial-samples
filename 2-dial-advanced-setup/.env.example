# Optional settings. The setup works without a .env file.
# To change something: cp .env.example .env, then edit .env (it is ignored by Git).
#
# This .env also applies to the simple-setup services that this folder includes,
# so any setting from ../1-dial-simple-setup/.env.example can go here too
# (for example OLLAMA_CHAT_MODEL or DIAL_CHAT_PORT).

# --- Platform ----------------------------------------------------------------
# Leave empty on Windows, Linux and Intel Macs. On an Apple Silicon Mac, set
# linux/amd64: Chat, Quick Apps, Admin, Evaluation and Scheduler have no ARM
# build, so Docker runs them through emulation.
DIAL_PLATFORM=

# --- Models ------------------------------------------------------------------
# Core deployment IDs used by Evaluation: an LLM judge and an embedding model.
EVALUATION_JUDGE_MODEL=ollama-qwen2.5
EVALUATION_EMBEDDING_MODEL=ollama-all-minilm

# --- Ports on localhost ------------------------------------------------------
# If changed, also update dial:applicationTypeEditorUrl in
# ../core/quick-apps-schemas.json.
QUICKAPPS_FRONTEND_PORT=8057
SCHEDULER_PORT=8067
EVALUATION_BACKEND_PORT=8060
EVALUATION_METRICS_PORT=8061
DIAL_ANALYTICS_PORT=8062
DIAL_ANALYTICS_RUNNER_PORT=8066

# --- Local development passwords and secrets ---------------------------------
# Generate your own values with: openssl rand -hex 32
SCHEDULER_POSTGRES_PASSWORD=local-scheduler-password
EVALUATION_POSTGRES_PASSWORD=local-evaluation-password
# Must match a Core API key: dial_evaluation_api_key comes from
# ../core/config.json.
DIAL_EVALUATION_API_KEY=dial_evaluation_api_key
ANALYTICS_POSTGRES_PASSWORD=local-analytics-password
ANALYTICS_CLICKHOUSE_PASSWORD=local-clickhouse-password
# Keep the encryption key unchanged while keeping ClickHouse data (64 hex chars).
ANALYTICS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ANALYTICS_CURSOR_SECRET=local-development-analytics-cursor-secret
# Base64-encoded Azurite shared key; generate with: openssl rand -base64 32
ANALYTICS_BLOB_KEY=bG9jYWwtYW5hbHl0aWNzLWJsb2Itc3RvcmFnZS1rZXk=
# Local service/bootstrap credential: Core's file-configured admin key.
# A replacement must exist in Core and have the admin role.
DIAL_ANALYTICS_API_KEY=dial_admin_api_key

# --- Admin Analytics --------------------------------------------------------
# Both API URLs and the Usage/Sessions feature flags are wired in Compose.
# Optional Core deployment for the Query Builder's AI view.
DIAL_QUERY_ASSISTANT_DEPLOYMENT=

# --- Image versions ----------------------------------------------------------
# docker-compose.yml pins versions that are tested together. To try another
# version, uncomment its line and change it.
# DIAL_QUICKAPPS_BACKEND_VERSION=0.13.1
# DIAL_QUICKAPPS_FRONTEND_VERSION=0.3.0
# Scheduler publishes only an AMD64 "development" image so far.
# DIAL_SCHEDULER_VERSION=development
# DIAL_EVALUATION_BACKEND_VERSION=0.5.0
# DIAL_EVALUATION_METRICS_VERSION=0.3.0
# Analytics and its runner are a matched pair of release candidates; change both.
# DIAL_ANALYTICS_VERSION=0.23.0-rc.0
# DIAL_ANALYTICS_RUNNER_VERSION=0.23.0-rc.0
