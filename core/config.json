{
  "applications": {
    "essay-assistant-app": {
      "displayName": "Essay Assistant",
      "description": "Writes short essays using a local Ollama model",
      "interfaces": {
        "openaiChatCompletions": {
          "mode": "passthrough",
          "base_url": "http://essay-assistant-app:5026"
        }
      },
      "features": {
        "configurationEndpoint": "http://essay-assistant-app:5026/openai/deployments/essay-assistant-app/configuration"
      },
      "userRoles": [
        "user",
        "admin",
        "default"
      ]
    },
    "agent-app-sample": {
      "displayName": "AI Agent Sample",
      "description": "Assistant with DuckDuckGo web search and configurable LLaVA picture analysis",
      "inputAttachmentTypes": [
        "image/png",
        "image/jpeg"
      ],
      "maxInputAttachments": 4,
      "interfaces": {
        "openaiChatCompletions": {
          "mode": "passthrough",
          "base_url": "http://agent-app-sample:5025"
        }
      },
      "userRoles": [
        "admin",
        "default"
      ]
    }
  },
  "models": {
    "ollama-qwen2.5": {
      "type": "chat",
      "displayName": "qwen2.5",
      "description": "Small Qwen 2.5 model running locally in Ollama",
      "overrideName": "qwen2.5:0.5b",
      "baseUrl": "http://model-provider:5000/compat/openai",
      "interfaces": {
        "openaiChatCompletions": {
          "mode": "passthrough"
        },
        "openaiResponses": {
          "mode": "passthrough"
        }
      },
      "upstreams": [
        {
          "id": "1",
          "key": "ollama",
          "interfaces": {
            "openaiChatCompletions": {
              "endpoint": "http://ollama:11434/v1/chat/completions"
            },
            "openaiResponses": {
              "endpoint": "http://ollama:11434/v1/responses"
            }
          }
        }
      ],
      "features": {
        "system_prompt_supported": true,
        "tools_supported": true
      }
    },
    "ollama-llama3.2": {
      "type": "chat",
      "displayName": "llama3.2",
      "description": "Small Llama 3.2 model (1B) running locally in Ollama",
      "overrideName": "llama3.2:1b",
      "baseUrl": "http://model-provider:5000/compat/openai",
      "interfaces": {
        "openaiChatCompletions": {
          "mode": "passthrough"
        },
        "openaiResponses": {
          "mode": "passthrough"
        }
      },
      "upstreams": [
        {
          "id": "1",
          "key": "ollama",
          "interfaces": {
            "openaiChatCompletions": {
              "endpoint": "http://ollama:11434/v1/chat/completions"
            },
            "openaiResponses": {
              "endpoint": "http://ollama:11434/v1/responses"
            }
          }
        }
      ],
      "features": {
        "system_prompt_supported": true,
        "tools_supported": true
      }
    },
    "ollama-all-minilm": {
      "type": "embedding",
      "displayName": "Ollama embeddings",
      "description": "Small all-MiniLM embedding model (384 dimensions) running locally in Ollama",
      "overrideName": "all-minilm",
      "interfaces": {
        "openaiEmbeddings": {
          "mode": "passthrough",
          "baseUrl": "http://model-provider:5000/compat/openai"
        }
      },
      "upstreams": [
        {
          "id": "1",
          "key": "ollama",
          "interfaces": {
            "openaiEmbeddings": {
              "endpoint": "http://ollama:11434/v1/embeddings"
            }
          }
        }
      ]
    },
    "ollama-qwen2.5-with-interceptor": {
      "type": "chat",
      "displayName": "qwen2.5 + pre/post interceptor",
      "description": "The same qwen2.5 model, wrapped by the pre-post-interceptor sample that adds a stage before and after the answer",
      "overrideName": "qwen2.5:0.5b",
      "baseUrl": "http://model-provider:5000/compat/openai",
      "interfaces": {
        "openaiChatCompletions": {
          "mode": "passthrough"
        }
      },
      "upstreams": [
        {
          "id": "1",
          "key": "ollama",
          "interfaces": {
            "openaiChatCompletions": {
              "endpoint": "http://ollama:11434/v1/chat/completions"
            }
          }
        }
      ],
      "interceptors": [
        "pre-post-interceptor"
      ],
      "userRoles": [
        "admin",
        "default"
      ]
    },
    "ollama-llava-vision": {
      "type": "chat",
      "displayName": "Ollama vision",
      "overrideName": "llava",
      "baseUrl": "http://model-provider:5000/compat/openai",
      "interfaces": {
        "openaiChatCompletions": {
          "mode": "passthrough"
        }
      },
      "inputAttachmentTypes": [
        "image/png",
        "image/jpeg"
      ],
      "upstreams": [
        {
          "id": "1",
          "key": "ollama",
          "interfaces": {
            "openaiChatCompletions": {
              "endpoint": "http://ollama:11434/v1/chat/completions"
            }
          }
        }
      ],
      "userRoles": [
        "admin",
        "default"
      ]
    },
    "gpt-6.1-terra": {
      "type": "chat",
      "displayName": "GPT 6.1 Terra",
      "endpoint": "http://model-provider:5000/compat/openai/openai/deployments/gpt-4o/chat/completions",
      "baseUrl": "http://model-provider:5000/compat/openai",
      "interfaces": {
        "openaiChatCompletions": {
          "mode": "passthrough"
        },
        "openaiResponses": {
          "mode": "passthrough"
        }
      },
      "upstreams": [
        {
          "id": "1",
          "key": "WRONG_KEY",
          "interfaces": {
            "openaiChatCompletions": {
              "endpoint": "https://api.openai.com/v1/chat/completions"
            },
            "openaiResponses": {
              "endpoint": "https://api.openai.com/v1/responses"
            }
          }
        }
      ],
      "features": {
        "tools_supported": true
      },
      "userRoles": [
        "admin"
      ]
    }
  },
  "keys": {
    "dial_api_key": {
      "project": "DIAL-DEMO",
      "role": "default"
    },
    "dial_evaluation_api_key": {
      "project": "DIAL-EVALUATION",
      "role": "default"
    }
  },
  "roles": {
    "default": {
      "limits": {}
    },
    "user": {
      "limits": {}
    },
    "admin": {
      "limits": {}
    },
    "ConfigAdmin": {
      "limits": {}
    }
  },
  "interceptors": {
    "pre-post-interceptor": {
      "interfaces": {
        "openaiChatCompletions": {
          "mode": "passthrough",
          "base_url": "http://pre-post-interceptor:5041"
        }
      }
    }
  }
}
