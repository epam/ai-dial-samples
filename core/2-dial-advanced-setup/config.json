{
  "applications": {
    "essay-assistant-app": {
      "userRoles": ["user", "admin", "default"]
    },
    "agent-app-sample": {
      "displayName": "AI Agent Sample",
      "description": "Assistant with DuckDuckGo web search and configurable LLaVA picture analysis",
      "inputAttachmentTypes": ["image/png", "image/jpeg"],
      "maxInputAttachments": 4,
      "interfaces": {
        "openaiChatCompletions": {
          "mode": "passthrough",
          "base_url": "http://agent-app-sample:5025"
        }
      },
      "userRoles": ["admin", "default"]
    }
  },
  "interceptors": {
    "pre-post-interceptor": {
      "interfaces": {
        "openaiChatCompletions": {
          "mode": "passthrough",
          "base_url": "http://pre-post-interceptor:5041"
        }
      }
    }
  },
  "models": {
    "ollama-qwen2.5-with-interceptor": {
      "type": "chat",
      "displayName": "qwen2.5 + pre/post interceptor",
      "description": "The same qwen2.5 model, wrapped by the pre-post-interceptor sample that adds a stage before and after the answer",
      "overrideName": "qwen2.5:0.5b",
      "endpoint": "http://adapter-dial-openai:5000/openai/deployments/qwen2.5/chat/completions",
      "upstreams": [
        {
          "id": "1",
          "endpoint": "http://ollama:11434/v1/chat/completions",
          "key": "ollama"
        }
      ],
      "interceptors": ["pre-post-interceptor"],
      "userRoles": ["admin", "default"]
    },
    "ollama-llava-vision": {
      "type": "chat",
      "displayName": "Ollama vision",
      "overrideName": "llava",
      "endpoint": "http://adapter-dial-openai:5000/openai/deployments/ollama-vision/chat/completions",
      "inputAttachmentTypes": ["image/png", "image/jpeg"],
      "upstreams": [
        {
          "id": "1",
          "endpoint": "http://ollama:11434/v1/chat/completions",
          "key": "ollama"
        }
      ],
      "userRoles": ["admin", "default"]
    },
    "gpt-4o": {
      "type": "chat",
      "displayName": "GPT 4o",
      "overrideName": "gpt-4o",
      "endpoint": "http://adapter-dial-openai:5000/openai/deployments/gpt-4o/chat/completions",
      "upstreams": [
        {
          "id": "1",
          "endpoint": "https://api.openai.com/v1/chat/completions",
          "key": ""
        }
      ],
      "features": {
        "toolsSupported": true
      },
      "userRoles": []
    },
    "claude-sonnet-4": {
      "type": "chat",
      "displayName": "Claude on Bedrock",
      "overrideName": "anthropic.claude-sonnet-4-20250514-v1:0",
      "endpoint": "http://adapter-dial-bedrock:5000/openai/deployments/anthropic.claude-sonnet-4-20250514-v1:0/chat/completions",
      "features": {
        "toolsSupported": true
      },
      "userRoles": [],
      "upstreams": []
    },
    "gemini": {
      "type": "chat",
      "displayName": "Gemini on Vertex AI",
      "overrideName": "gemini-2.5-flash",
      "endpoint": "http://adapter-dial-vertexai:5000/openai/deployments/gemini-2.5-flash/chat/completions",
      "features": {
        "toolsSupported": true
      },
      "userRoles": [],
      "upstreams": []
    }
  },
  "keys": {
    "dial_evaluation_api_key": {
      "project": "DIAL-EVALUATION",
      "role": "default"
    }
  },
  "roles": {
    "ConfigAdmin": {
      "limits": {}
    }
  }
}
